# ============================================================
#  SevaCoop Backend — Environment Variables Template
#  Copy this file to `.env` and fill in REAL values.
#  NEVER commit `.env` to git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# For Supabase / Postgres (recommended for production):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# If your password has special chars, URL-encode them (# → %23, @ → %40)
#
# For local SQLite development ONLY:
# DATABASE_URL=sqlite:///./sevacoop.db
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── JWT Secret ───────────────────────────────────────────────
# Generate a strong random key (REQUIRED — app refuses to start without this):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME_WITH_A_STRONG_RANDOM_KEY

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In development this defaults to http://localhost:5173 so you can leave it blank.
# In production, set it to your real domain(s):
# ALLOWED_ORIGINS=https://sevacoop.in,https://www.sevacoop.in
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Trusted Hosts ────────────────────────────────────────────
# Comma-separated Host header allowlist (leave empty to skip host filtering):
ALLOWED_HOSTS=localhost,127.0.0.1

# ── OpenAPI Docs ─────────────────────────────────────────────
# Set to 1 to enable /docs and /redoc (local dev only — NEVER in production)
ENABLE_DOCS=0

# ── Admin Account (created automatically on first start) ─────
ADMIN_NAME=ADMIN
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
ADMIN_PHONE=9999999999
