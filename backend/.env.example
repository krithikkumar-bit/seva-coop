# ============================================================
#  SevaCoop Backend — Environment Variables Template
#  Copy this file to `.env` and fill in REAL values.
#  NEVER commit `.env` to git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── JWT Secret (REQUIRED >= 32 chars) ────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME_WITH_A_STRONG_RANDOM_KEY

# ── CORS & Host Allowlists ───────────────────────────────────
ALLOWED_ORIGINS=https://seva-coop-ecru.vercel.app,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGIN_REGEX=^https://seva-coop(-[a-z0-9-]+)?\.vercel\.app$
ALLOWED_HOSTS=localhost,127.0.0.1,seva-coop-ecru.vercel.app

# ── OpenAPI Docs (set 0 in production) ───────────────────────
ENABLE_DOCS=0

# ── Admin Account (created automatically on first start) ─────
ADMIN_NAME=ADMIN
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
ADMIN_PHONE=9999999999

# ── Razorpay Payment Gateway (leave blank for signed sandbox) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ALLOW_MOCK_PAYMENTS=1
